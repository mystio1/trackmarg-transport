# Copy this file to .env and fill in real values. Never commit the real .env file.

# Backend server URL
# In production (after npm run build), the server serves the frontend too,
# so the API is on the same origin — leave this empty or set to your laptop's LAN IP.
# Example for LAN access: VITE_API_URL=http://192.168.1.100:4000
# For the packaged mobile app build, set this to your permanent backend URL (e.g. the Render URL)
# so the app has a real server to talk to by default.
VITE_API_URL=

# Where "Exit to TrackMarg" in the header goes. Leave unset to use https://trackmarg.in.
VITE_TRACKMARG_URL=

# SendGrid (for emailing password reset codes / bills / payment reminders). Used by the v2
# backend (backend/src/) — sends over SendGrid's HTTPS API rather than raw SMTP, since Render's
# free tier blocks outbound SMTP (ports 465/587) entirely, which made nodemailer/Gmail SMTP hang
# indefinitely there. HTTPS isn't blocked on any tier.
# 1. Create a free SendGrid account: https://signup.sendgrid.com/
# 2. Settings > Sender Authentication > Verify a Single Sender, using the address below (no
#    domain ownership needed — just click the confirmation link SendGrid emails to it).
# 3. Settings > API Keys > Create API Key, then paste it below.
SENDGRID_API_KEY=
SENDER_EMAIL=

# Legacy Gmail SMTP — only used by the frozen v1 backend (backend/server.mjs), which is never
# deployed to Render and so isn't affected by the SMTP port block above.
# 1. Turn on 2-Step Verification on the Gmail account: https://myaccount.google.com/security
# 2. Create an "App Password": https://myaccount.google.com/apppasswords
# 3. Paste the sending Gmail address and the 16-character app password below (no spaces needed).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# MongoDB Atlas — legacy fallback used only by the v1 backend (backend/server.mjs).
# The v2 backend (backend/src, Prisma/Postgres below) never reads these; they're kept here until
# the v1 server is retired in the rebuild's later phases.
# Leaving this blank falls back to the local file automatically.
MONGODB_URI=
# Optional — database name inside the cluster. Defaults to "shivam_transport" if left blank.
MONGODB_DB=

# --- Postgres (Supabase) — used by Prisma (prisma/schema.prisma) for the v2 backend ---
# Supabase fronts Postgres with PgBouncer, so two different connection strings are required:
#
# DATABASE_URL — the POOLED connection string, used by the running app for normal request
#   traffic. In the Supabase dashboard: Project Settings -> Database -> "Connection Pooling"
#   section -> "Transaction" mode -> copy the URI (port 6543). Append `?pgbouncer=true` if it
#   isn't already present — this tells Prisma's query engine to skip features PgBouncer's
#   transaction-mode pooling can't support (prepared statements).
# DIRECT_URL — the DIRECT connection string, used only by `prisma migrate`/`prisma db push`
#   (never by the running app). Same dashboard page -> "Connection string" section (port 5432).
#   PgBouncer's transaction-mode pooling doesn't support the session-level advisory locks the
#   migration engine needs, so migrations must bypass the pooler entirely.
#
# Both point at the same database; only host/port/query-string differ.
DATABASE_URL=
DIRECT_URL=

# Signs session tokens. MUST be set on any host with an ephemeral filesystem (e.g. Render) —
# otherwise every restart invalidates all logged-in sessions. Locally this falls back to a
# generated file (backend/data/.session_secret) if left blank, so it's optional here.
SESSION_SECRET=

# Master password for the internal /support console — lets us look up any client business by its
# group code and open its admin account directly, for remote troubleshooting. Leaving this blank
# disables the feature entirely (the backend 404s the /api/support/* routes). Set a long, unique
# password here — anyone with it can access every client's data.
SUPPORT_ACCESS_PASSWORD=
